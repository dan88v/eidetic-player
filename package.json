{
  "name": "eidetic-player",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "node scripts/build-orchestrator.mjs app",
    "build:ui": "vite build --config apps/ui/vite.config.ts",
    "build:remote": "vite build --config apps/remote-ui/vite.config.ts",
    "build:backend": "tsc -p apps/backend/tsconfig.build.json",
    "build:info": "node scripts/generate-build-info.mjs --output dist/build-info.json",
    "clean": "node scripts/clean.mjs",
    "typecheck": "tsc -p apps/ui/tsconfig.json && tsc -p apps/remote-ui/tsconfig.json && tsc -p apps/backend/tsconfig.json && tsc -p scripts/tsconfig.json && tsc -p packages/on-screen-keyboard/tsconfig.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "tsx --test apps/backend/test/*.test.ts apps/ui/test/*.test.ts packages/on-screen-keyboard/test/*.test.ts",
    "test:remote": "tsx --test apps/backend/test/remote-access*.test.ts apps/remote-ui/test/*.test.ts",
    "test:mpv": "tsx --test apps/backend/test/mpv.integration.ts",
    "mpv:doctor": "tsx scripts/mpv-doctor.ts",
    "ffmpeg:doctor": "tsx scripts/ffmpeg-doctor.ts",
    "test:ffmpeg": "tsx --test apps/backend/test/ffmpeg.integration.ts",
    "doctor:linux": "tsx scripts/doctor-linux.ts",
    "doctor:install:linux": "bash deploy/linux/doctor-installation.sh",
    "doctor:network:linux": "tsx scripts/doctor-network-linux.ts",
    "verify:network:deployment": "tsx scripts/verify-network-deployment.ts",
    "verify:linux:executables": "node scripts/verify-linux-executable-modes.mjs",
    "test:install:linux": "node scripts/run-linux-install-safe-tests.mjs",
    "verify:linux:release": "tsx scripts/verify-linux-release.ts",
    "verify:linux:installer": "npm run verify:linux:executables && tsx scripts/verify-linux-installer-contract.ts && npm run test:install:linux && npm run verify:network:deployment",
    "test:linux": "npm run test:case-sensitive && npm run test:posix && npm test",
    "test:posix": "tsx --test apps/backend/test/linux-platform.test.ts",
    "test:case-sensitive": "tsx scripts/test-case-sensitive.ts",
    "build:linux": "node scripts/build-orchestrator.mjs linux",
    "smoke:linux": "tsx scripts/linux-smoke.ts",
    "verify:arm": "tsx scripts/verify-arm.ts",
    "benchmark:library-search": "tsx scripts/library-search-benchmark.ts",
    "shell:config:dev": "tsx scripts/generate-neutralino-config.ts development",
    "shell:config:prod": "tsx scripts/generate-neutralino-config.ts production",
    "neutralino:sync": "neu update",
    "neutralino:build": "neu build --release",
    "neutralino:update": "neu update --latest"
  },
  "dependencies": {
    "@neutralinojs/lib": "6.8.0",
    "music-metadata": "11.14.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@neutralinojs/neu": "11.7.2",
    "@types/node": "24.10.1",
    "eslint": "10.0.3",
    "prettier": "3.9.5",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "8.1.5"
  }
}
