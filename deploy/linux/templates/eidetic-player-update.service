[Unit]
Description=Eidetic Player software update
After=network-online.target
Wants=network-online.target
ConditionPathExists=/var/lib/eidetic-player/update/request.json

[Service]
Type=oneshot
ExecStart=/usr/libexec/eidetic-player-update-runner
User=root
Group=__EIDETIC_RUNTIME_USER__
UMask=0027
# The fixed privileged runner deliberately drops to the runtime UID for every
# source fetch and application build. NoNewPrivileges blocks that required
# runuser transition on Raspberry Pi OS.
NoNewPrivileges=no
PrivateTmp=yes
ProtectHome=false
ProtectSystem=false
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native
TimeoutStartSec=infinity
