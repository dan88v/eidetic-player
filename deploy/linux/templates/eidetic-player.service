[Unit]
Description=Eidetic Player
After=graphical-session.target network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
EnvironmentFile=/etc/eidetic-player/install.conf
ExecStart=/opt/eidetic-player/current/bin/eidetic-player-launch
Restart=on-failure
RestartSec=3
TimeoutStopSec=15

[Install]
WantedBy=default.target
