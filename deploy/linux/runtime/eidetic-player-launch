#!/usr/bin/env bash
set -euo pipefail

runtime="${XDG_RUNTIME_DIR:?}/eidetic-player"
[[ ! -e "$runtime/maintenance" ]] || exit 0
node_bin="${EIDETIC_NODE_BIN:-/opt/eidetic-player/node/current/bin/node}"
release="${EIDETIC_PLAYER_RELEASE:-/opt/eidetic-player/current}"
backend_entry="$release/backend/apps/backend/src/index.js"
backend_host="${BACKEND_HOST:-127.0.0.1}"
backend_port="${BACKEND_PORT:-4310}"
readiness_timeout_ms="${EIDETIC_READINESS_TIMEOUT_MS:-30000}"
readiness_poll_ms=250
max_readiness_attempts=$((readiness_timeout_ms / readiness_poll_ms))
readiness_json="$runtime/readiness.json"
readiness_endpoint="http://${backend_host}:${backend_port}/api/readiness"
ui_watchdog_failure="$runtime/ui-watchdog-failure"
ui_renderer_memory_limit_kib="${EIDETIC_UI_RENDERER_MEMORY_LIMIT_KIB:-524288}"
ui_renderer_check_seconds="${EIDETIC_UI_RENDERER_CHECK_SECONDS:-5}"
ui_renderer_over_limit_samples="${EIDETIC_UI_RENDERER_OVER_LIMIT_SAMPLES:-3}"
child_termination_timeout_seconds="${EIDETIC_CHILD_TERMINATION_TIMEOUT_SECONDS:-7}"
runtime_recovery_state="${XDG_STATE_HOME:-${HOME:?}/.local/state}/eidetic-player"
runtime_recovery_log="$runtime_recovery_state/runtime-recovery.log"
runtime_recovery_log_max_bytes=65536

if [[ ! -f "$backend_entry" ]]; then
  printf 'Eidetic Player backend entrypoint not found: %s\n' \
    "$backend_entry" >&2
  exit 1
fi

if [[ "$backend_host" != "127.0.0.1" && "$backend_host" != "localhost" ]]; then
  printf 'Invalid BACKEND_HOST=%s; only 127.0.0.1 or localhost are allowed in production.\n' \
    "$backend_host" >&2
  exit 1
fi

if ! [[ "$backend_port" =~ ^[0-9]+$ ]] || ((backend_port < 1 || backend_port > 65535)); then
  printf 'Invalid BACKEND_PORT=%s; must be an integer 1-65535.\n' \
    "$backend_port" >&2
  exit 1
fi

if ! [[ "$readiness_timeout_ms" =~ ^[0-9]+$ ]] || ((readiness_timeout_ms < 1)); then
  printf 'Invalid readiness timeout=%s; must be a positive integer.\n' \
    "$readiness_timeout_ms" >&2
  exit 1
fi

if ! [[ "$ui_renderer_memory_limit_kib" =~ ^[0-9]+$ ]] ||
  ((ui_renderer_memory_limit_kib < 131072)); then
  printf 'Invalid UI renderer memory limit=%s; must be at least 131072 KiB.\n' \
    "$ui_renderer_memory_limit_kib" >&2
  exit 1
fi

if ! [[ "$ui_renderer_check_seconds" =~ ^[0-9]+$ ]] ||
  ((ui_renderer_check_seconds < 1)); then
  printf 'Invalid UI renderer check interval=%s; must be a positive integer.\n' \
    "$ui_renderer_check_seconds" >&2
  exit 1
fi

if ! [[ "$ui_renderer_over_limit_samples" =~ ^[0-9]+$ ]] ||
  ((ui_renderer_over_limit_samples < 1)); then
  printf 'Invalid UI renderer sample count=%s; must be a positive integer.\n' \
    "$ui_renderer_over_limit_samples" >&2
  exit 1
fi

if ! [[ "$child_termination_timeout_seconds" =~ ^[0-9]+$ ]] ||
  ((child_termination_timeout_seconds < 1 || child_termination_timeout_seconds > 30)); then
  printf 'Invalid child termination timeout=%s; must be an integer from 1 to 30 seconds.\n' \
    "$child_termination_timeout_seconds" >&2
  exit 1
fi

find_web_renderer_pid() {
  local parent_pid="$1"
  local child_pid executable
  [[ -r "/proc/$parent_pid/task/$parent_pid/children" ]] || return 1
  for child_pid in $(<"/proc/$parent_pid/task/$parent_pid/children"); do
    [[ -r "/proc/$child_pid/cmdline" ]] || continue
    IFS= read -r -d '' executable <"/proc/$child_pid/cmdline" || true
    if [[ "${executable##*/}" == "WebKitWebProcess" ]]; then
      printf '%s\n' "$child_pid"
      return 0
    fi
  done
  return 1
}

renderer_memory_kib() {
  local renderer_pid="$1"
  local key value _unit total=0
  [[ -r "/proc/$renderer_pid/status" ]] || return 1
  while read -r key value _unit; do
    case "$key" in
      VmRSS:|VmSwap:) total=$((total + value)) ;;
    esac
  done <"/proc/$renderer_pid/status"
  printf '%s\n' "$total"
}

record_runtime_recovery() (
  local reason="$1"
  local status="${2:-na}"
  local memory_kib="${3:-na}"
  local log_size=0 mem_available_kib="na" swap_free_kib="na"

  umask 077
  [[ ! -L "$runtime_recovery_state" ]] || return 0
  mkdir -p "$runtime_recovery_state" || return 0
  chmod 0700 "$runtime_recovery_state" 2>/dev/null || return 0
  [[ -d "$runtime_recovery_state" && ! -L "$runtime_recovery_log" ]] || return 0
  [[ ! -e "$runtime_recovery_log" || -f "$runtime_recovery_log" ]] || return 0
  if [[ -f "$runtime_recovery_log" ]]; then
    log_size="$(stat -c %s "$runtime_recovery_log" 2>/dev/null || printf '0')"
    if [[ "$log_size" =~ ^[0-9]+$ ]] &&
      ((log_size >= runtime_recovery_log_max_bytes)); then
      [[ ! -d "$runtime_recovery_log.previous" ]] || return 0
      mv -f "$runtime_recovery_log" "$runtime_recovery_log.previous" || return 0
    fi
  fi
  mem_available_kib="$(awk '/^MemAvailable:/{print $2; exit}' /proc/meminfo 2>/dev/null || true)"
  swap_free_kib="$(awk '/^SwapFree:/{print $2; exit}' /proc/meminfo 2>/dev/null || true)"
  printf '%s reason=%s status=%s renderer_kib=%s mem_available_kib=%s swap_free_kib=%s\n' \
    "$(date --iso-8601=seconds)" "$reason" "$status" "$memory_kib" \
    "${mem_available_kib:-na}" "${swap_free_kib:-na}" >>"$runtime_recovery_log" || return 0
  chmod 0600 "$runtime_recovery_log" 2>/dev/null || true
)

watch_ui_renderer() {
  local parent_pid="$1"
  local watched_backend_pid="$2"
  local renderer_pid="" replacement_pid="" memory_kib=""
  local missing_samples=0 over_limit_count=0

  while kill -0 "$parent_pid" 2>/dev/null; do
    if ! kill -0 "$watched_backend_pid" 2>/dev/null; then
      printf 'Backend exited while the UI shell remained alive; restarting Eidetic Player.\n' >&2
      record_runtime_recovery backend-exited
      printf 'backend-exited\n' >"$ui_watchdog_failure"
      kill -TERM "$parent_pid" 2>/dev/null || true
      return 1
    fi

    if [[ -z "$renderer_pid" ]]; then
      renderer_pid="$(find_web_renderer_pid "$parent_pid" || true)"
      sleep 1
      continue
    fi

    if [[ ! -r "/proc/$renderer_pid/status" ]]; then
      replacement_pid="$(find_web_renderer_pid "$parent_pid" || true)"
      if [[ -n "$replacement_pid" ]]; then
        renderer_pid="$replacement_pid"
        missing_samples=0
        over_limit_count=0
      else
        missing_samples=$((missing_samples + 1))
        if ((missing_samples >= 3)); then
          printf 'WebKit renderer exited while the UI shell remained alive; restarting Eidetic Player.\n' >&2
          record_runtime_recovery renderer-exited
          printf 'renderer-exited\n' >"$ui_watchdog_failure"
          kill -TERM "$parent_pid" 2>/dev/null || true
          return 1
        fi
      fi
      sleep 1
      continue
    fi

    missing_samples=0
    memory_kib="$(renderer_memory_kib "$renderer_pid" || true)"
    if [[ "$memory_kib" =~ ^[0-9]+$ ]] &&
      ((memory_kib >= ui_renderer_memory_limit_kib)); then
      over_limit_count=$((over_limit_count + 1))
      if ((over_limit_count >= ui_renderer_over_limit_samples)); then
        printf 'WebKit renderer memory remained above the safe limit (%s KiB >= %s KiB); restarting Eidetic Player before system OOM.\n' \
          "$memory_kib" "$ui_renderer_memory_limit_kib" >&2
        record_runtime_recovery renderer-memory-limit na "$memory_kib"
        printf 'renderer-memory-limit\n' >"$ui_watchdog_failure"
        kill -TERM "$parent_pid" 2>/dev/null || true
        return 1
      fi
    else
      over_limit_count=0
    fi
    sleep "$ui_renderer_check_seconds"
  done
}

"$node_bin" "$backend_entry" &
backend_pid=$!
gui_pid=
watchdog_pid=

child_has_exited() {
  local child_pid="$1" state=""
  [[ ! -r "/proc/$child_pid/stat" ]] && return 0
  state="$(awk '{ print $3; exit }' "/proc/$child_pid/stat" 2>/dev/null || true)"
  [[ "$state" == "Z" ]]
}

await_child_exit() {
  local child_pid="$1" child_name="$2"
  local attempt=0 max_attempts=$((child_termination_timeout_seconds * 4))

  [[ -n "$child_pid" && "$child_pid" =~ ^[0-9]+$ ]] || return 0
  while ((attempt < max_attempts)); do
    if child_has_exited "$child_pid"; then
      wait "$child_pid" 2>/dev/null || true
      return 0
    fi
    sleep 0.25
    attempt=$((attempt + 1))
  done

  printf '%s did not terminate within %s seconds; forcing only supervised PID %s to exit.\n' \
    "$child_name" "$child_termination_timeout_seconds" "$child_pid" >&2
  record_runtime_recovery "${child_name,,}-termination-timeout"
  kill -KILL "$child_pid" 2>/dev/null || true
  attempt=0
  while ((attempt < 40)) && ! child_has_exited "$child_pid"; do
    sleep 0.05
    attempt=$((attempt + 1))
  done
  if child_has_exited "$child_pid"; then
    wait "$child_pid" 2>/dev/null || true
  else
    printf '%s PID %s remained uninterruptible after SIGKILL; leaving final cgroup cleanup to systemd.\n' \
      "$child_name" "$child_pid" >&2
    record_runtime_recovery "${child_name,,}-unkillable"
  fi
}

# Invoked indirectly by the EXIT, INT and TERM traps below.
# shellcheck disable=SC2317
cleanup() {
  [[ -z "${watchdog_pid:-}" ]] || kill -TERM "$watchdog_pid" 2>/dev/null || true
  [[ -z "${gui_pid:-}" ]] || kill -TERM "$gui_pid" 2>/dev/null || true
  kill -TERM "$backend_pid" 2>/dev/null || true
  await_child_exit "${watchdog_pid:-}" watchdog
  await_child_exit "${gui_pid:-}" ui
  await_child_exit "$backend_pid" backend
  rm -f "$readiness_json" "$ui_watchdog_failure"
}
trap cleanup EXIT INT TERM

readiness_code=
for attempt in $(seq 1 "$max_readiness_attempts"); do
  readiness_code="$(curl --silent --max-time 1 \
    --write-out "%{http_code}" \
    --output "$readiness_json" \
    "$readiness_endpoint" || printf "000")"
  if [[ "$readiness_code" == "200" ]]; then
    break
  fi
  if ! kill -0 "$backend_pid" 2>/dev/null; then
    printf 'backend process ended during readiness check (attempt %d)\n' "$attempt" >&2
    exit 1
  fi
  if [[ "$attempt" -ge "$max_readiness_attempts" ]]; then
    # Keep final diagnostic outside the loop; see final block below.
    exit 1
  fi
  sleep "0.$((readiness_poll_ms / 10))"
done

if [[ "$readiness_code" != "200" ]]; then
  printf 'Backend readiness was not reachable at %s:%s within %d ms\n' \
    "$backend_host" "$backend_port" "$readiness_timeout_ms" >&2
  exit 1
fi
rm -f "$runtime/readiness.json"
rm -f "$ui_watchdog_failure"

"$release/eidetic-player" &
gui_pid=$!
watch_ui_renderer "$gui_pid" "$backend_pid" &
watchdog_pid=$!
gui_status=0
wait "$gui_pid" || gui_status=$?
gui_pid=
kill "$watchdog_pid" 2>/dev/null || true
wait "$watchdog_pid" 2>/dev/null || true
watchdog_pid=
if [[ -s "$ui_watchdog_failure" ]]; then
  gui_status=1
elif ((gui_status == 0)); then
  printf 'UI shell exited unexpectedly with status 0; restarting Eidetic Player.\n' >&2
  record_runtime_recovery ui-exit "$gui_status"
  gui_status=1
else
  record_runtime_recovery ui-exit "$gui_status"
fi
exit "$gui_status"
